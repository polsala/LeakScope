+
+/* LeakScope laboratory wrappers. Recursion is suppressed per native thread. */
+void *PyObject_Malloc(size_t size) {
+    void *p; int outer=ls_depth++ == 0;
+    if(outer)ls_begin_event();
+    p=ls_original_Malloc(size); --ls_depth;
+    if (outer) ls_record(1,p,NULL,size);
+    return p;
+}
+void PyObject_Free(void *p) {
+    int outer=ls_depth++ == 0;
+    if(outer)ls_begin_event();
+    if (outer) ls_record(2,p,NULL,0);
+    ls_original_Free(p); --ls_depth;
+}
+void *PyObject_Realloc(void *old, size_t size) {
+    void *p; int outer=ls_depth++ == 0;
+    if(outer)ls_begin_event();
+    p=ls_original_Realloc(old,size); --ls_depth;
+    if (outer) ls_record(3,p,old,size);
+    return p;
+}
